{
  "name": "clawpost",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "clawpost": "dist/clawpost.js"
  },
  "scripts": {
    "dev": "wrangler dev --remote",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "cli": "bun run ./src/cli/index.ts",
    "build:cli": "bun build ./src/cli/index.ts --outfile dist/clawpost.js --target node"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "agents": "^0.0.74",
    "commander": "^13.1.0",
    "hono": "^4.7.6",
    "kysely": "^0.28.2",
    "kysely-d1": "^0.3.0",
    "postal-mime": "^2.4.1",
    "resend": "^4.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.1"
  }
}
